{
  "name": "wishlist-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers for wishlist management",
  "private": true,
  "scripts": {
    "dev:amazon": "cd amazon-scraper && wrangler dev",
    "dev:mercadolibre": "cd mercadolibre-scraper && wrangler dev",
    "dev:sheets": "cd sheets-proxy && wrangler dev",
    "dev:sync": "cd sync-wishlist && wrangler dev",
    "deploy:amazon": "cd amazon-scraper && wrangler deploy",
    "deploy:mercadolibre": "cd mercadolibre-scraper && wrangler deploy",
    "deploy:sheets": "cd sheets-proxy && wrangler deploy",
    "deploy:sync": "cd sync-wishlist && wrangler deploy",
    "deploy:all": "npm run deploy:amazon && npm run deploy:mercadolibre && npm run deploy:sheets && npm run deploy:sync"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}
