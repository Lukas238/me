{
  "name": "site-workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers for the site: wishlist and comments inboxes",
  "private": true,
  "scripts": {
    "dev:wishlist": "cd wishlist-sync && wrangler dev",
    "dev:comments": "cd comments-worker && wrangler dev",
    "deploy:wishlist": "cd wishlist-sync && wrangler deploy",
    "deploy:comments": "cd comments-worker && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.158.0"
  }
}
